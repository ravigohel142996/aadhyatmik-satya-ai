# Copy to .env and fill only what you have. Never commit real keys.

# OpenAI-compatible chat endpoint. Leave blank to use the grounded extractive engine.
# Examples:
#   OpenAI:  LLM_API_BASE=https://api.openai.com/v1
#   Groq:    LLM_API_BASE=https://api.groq.com/openai/v1
#   Ollama:  LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=
LLM_PROVIDER=openai_compatible
LLM_TIMEOUT_SECONDS=40

# local_hash works offline. sentence_transformers is optional if installed.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=local-multilingual-hash-384
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=

# Default local database. For PostgreSQL use a SQLAlchemy URL and install psycopg.
DATABASE_URL=sqlite:///./backend/data/aadhyatmik.db

# Optional. If unset, vectors stay in the local SQLite index.
VECTOR_DB_URL=

# Required to open /admin write actions. Change this.
ADMIN_TOKEN=change-me-local-admin

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO

# Public source folder used for scan links. Do not put secrets here.
SOURCE_DRIVE_FOLDER_ID=1JeudaFEZxohJkYfh-uBtYSgYBbwg5wGV
BOOK_CHUNKS_PATH=book_chunks.json
